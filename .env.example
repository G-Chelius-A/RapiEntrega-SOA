# Plantilla de variables de entorno para Alquila YA
# Copia este archivo como .env y ajusta los valores a tu entorno local

# URL de conexión completa a MySQL
DB_URL=jdbc:mysql://localhost:3306/fitzone?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=tu_usuario
DB_PASSWORD=tu_contraseña
